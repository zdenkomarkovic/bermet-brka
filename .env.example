# SMTP Email Configuration
# Podešavanja za slanje emailova sa narudžbinama

# SMTP server hostname (npr. smtp.gmail.com za Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP port (obično 587 za TLS ili 465 za SSL)
SMTP_PORT=587

# Email adresa koja šalje emailove
SMTP_USER=your-email@gmail.com

# Password ili App Password za email (za Gmail koristiti App Password)
# Kako napraviti Gmail App Password: https://support.google.com/accounts/answer/185833
SMTP_PASS=your-app-password

# Email adresa koja prima narudžbine
CONTACT_EMAIL=orders@example.com
